{
  "name": "ajeita-csv",
  "description": "Extensão Chrome para abrir, corrigir, limpar e criar arquivos CSV, com foco no Brasil.",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "gen:fixtures": "node scripts/generate-fixtures.ts",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.25",
    "fflate": "^0.8.3",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  }
